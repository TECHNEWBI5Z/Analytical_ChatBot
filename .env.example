# Create a MySQL user with SELECT permission only. Never use root here.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=analytics_reader
MYSQL_PASSWORD=change_me

# Install Ollama, then run: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# Free local speech-to-text model. `tiny.en` downloads once (~75 MB) on first use.
WHISPER_MODEL=tiny.en
